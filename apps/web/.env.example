# Copy to .env (gitignored) once red-aliados' own Supabase project exists.
# See supabase/THIRD_PARTY_AUTH.md for the full identity-bridge setup this
# feeds into (task 2.1) -- these two values alone do not configure
# Third-Party Auth, they only point the client SDK at the project.

VITE_SUPABASE_URL=https://<red-aliados-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<red-aliados-project-anon-key>
