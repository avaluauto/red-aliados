# Single env file for red-aliados (monorepo root). Copy to .env (gitignored).
# apps/web (Vite) reads this via envDir -- only VITE_-prefixed vars reach
# the browser bundle. The rest are Supabase Edge Function secrets, set on
# Supabase via `supabase secrets set --env-file .env` -- Edge Functions run
# on Supabase's infra and never read this file directly, this is just the
# source of truth you deploy from.
# See supabase/THIRD_PARTY_AUTH.md and supabase/functions/README.md.

# --- Client (apps/web, Vite) ---
VITE_SUPABASE_URL=https://<red-aliados-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<red-aliados-project-anon-key>

# --- Edge Functions (supabase secrets set --env-file .env) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ingest-vehicle-event
VEHICLE_SYNC_WEBHOOK_SECRET=

# reconcile-outbox
RECONCILE_OUTBOX_SECRET=
V2_OUTBOX_BASE_URL=
V2_OUTBOX_API_KEY=